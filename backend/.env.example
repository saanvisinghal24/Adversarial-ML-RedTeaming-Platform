# Copy to .env and adjust. Read only through app.core.config.Settings.
DATABASE_URL=postgresql+psycopg://redteam:redteam@localhost:5432/redteam
JWT_SECRET=change-me-before-anyone-else-runs-this
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
STORAGE_DIR=./storage
MAX_MODEL_SIZE_MB=200
SCAN_TIMEOUT_SECONDS=600
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
LOG_LEVEL=INFO
ENVIRONMENT=dev
